# Copy this file to .env and fill in your key. .env is listed in .gitignore.
# Keys are created at https://dash.molochai.dev/account?utm_source=github&utm_medium=oss&utm_campaign=uncensored-llm-examples
# and shown once.
MOLOCHAI_API_KEY=your-api-key

# Optional. Defaults to https://api.molochai.dev/api/v1.
# Point it at the mock server (http://127.0.0.1:4010/api/v1, key mock-key)
# or at a self-hosted OpenAI-compatible server. See local-development/.
# MOLOCHAI_BASE_URL=https://api.molochai.dev/api/v1

# Optional. Model id used when an example is run without --model.
# MOLOCHAI_MODEL=glm-5.3-flash
